<Window x:Class="QuickAccessTrail.WPF.FloorLevelWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuickAccessTrail.WPF"
             mc:Ignorable="d" Title="Floor List As per Level"
             Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Select Level:" Margin="0,0,15,0" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding FilteredLevels}" SelectedItem="{Binding SelectedLevel}"
                      Width="250" Height="25"/>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredFloors}" SelectedItem="{Binding SelectedFloor}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Floor Name" Binding="{Binding FloorName}" Width="160"/>
                <DataGridTextColumn Header="Levels" Binding="{Binding LevelName}" Width="120"/>
                <DataGridTextColumn Header="Area" Binding="{Binding FloorArea}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Orientation="Vertical">
            <TextBlock Text="{Binding Status}" Foreground="Blue" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding FloorArea}" Foreground="Blue" HorizontalAlignment="Left"/>
        </StackPanel>
        <Button Grid.Row="6" Content="Export" Width="120" Height="32" HorizontalAlignment="Right"
                VerticalAlignment="Center" Click="btnExport_click"/>
    </Grid>
</Window>
