<Window x:Class="QuickAccessTrail.WPF.SectionBoxLinkedElement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuickAccessTrail.WPF"
             mc:Ignorable="d" 
             Height="180" Width="300" Title="Zoom Element in 3D view" HorizontalAlignment="Center">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Zoom Linked Element" HorizontalAlignment="Center" FontSize="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="2">
            <TextBlock Text="ThreeD Name" FontSize="10" Width="60" Margin="0,0,15,0"/>
            <TextBox x:Name="txtThreeD" FontSize="10" Width="150" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="4">
            <TextBlock Text="Padding" FontSize="10" Width="60" Margin="0,0,15,0"/>
            <TextBox x:Name="txtPadding" Text="500" FontSize="10" Width="50" TextAlignment="Center"/>
        </StackPanel>
        <Button Grid.Row="6" x:Name="btnZoom" Content="Zoom" Width="100" Height="25" Click="btnZoom_click"/>
    </Grid>
</Window>
