<Window x:Class="QuickAccessTrail.WPF.ZoomWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuickAccessTrail.WPF"
             mc:Ignorable="d" Title="Zoom Linked Element"
             Height="200" Width="350" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text= "-:Zoom Linked Element:-" HorizontalAlignment="Center"
                   FontSize="12" FontWeight="Medium" Margin="0,5"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            </Grid>
            <TextBlock Text="Linked Element ID : " Grid.Column="0" Margin="0,5"/>
            <TextBox x:Name="txtElementId" Grid.Column="2" Margin="20,5" Width="150"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            </Grid>
            <TextBlock Text="Padding (mm) : " Grid.Column="0" Margin="0,5"/>
            <TextBox x:Name="txtPadding" Grid.Column="2" Margin="40,5" Width="150" Text="500"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="btnZoom" Content="Zoom" Width="80" Margin="5" Click="btnZoom_click"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="5" Click="btnCancel_click"/>
        </StackPanel>
    </Grid>
</Window>
