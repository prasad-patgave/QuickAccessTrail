<Window x:Class="QuickAccessTrail.WPF.EqTextWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuickAccessTrail.WPF"
             mc:Ignorable="d" 
             Height="150" Width="350" SizeToContent="WidthAndHeight" ResizeMode="NoResize" Title="Dimension Override">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Text="Replaced With Text     : " FontSize="14" FontWeight="Normal" Margin="5,5,5,5"/>
        <TextBox Grid.Column="1" x:Name="txtReplacedText" FontSize="12" FontWeight="Light" Margin="15,0,0,5" Height="20" Width="100"/>
        <TextBlock Grid.Row="1" Text="Tolerence                    : " FontSize="14" FontWeight="Normal" Margin="5,5,5,5"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTolerence" FontSize="12" FontWeight="Light" Margin="15,0,0,5" Height="20" Width="100"/>
        <Button Grid.Row="1" x:Name="btnReplace" FontSize="16" FontWeight="Bold" Height="30" Width="200" Content="Replace" Grid.ColumnSpan="2" Margin="58,50,57,0" Grid.RowSpan="2" Click="btnReplace_Click"/>
    </Grid>
</Window>
