<Window x:Class="QuickAccessTrail.WPF.DimensionOverride"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QuickAccessTrail.WPF"
             mc:Ignorable="d" 
             Height="150" Width="300" Title="All Dimension Segment override by Text">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Text="Replacement Text:     " FontSize="12" FontWeight="SemiBold"/>
            <TextBox x:Name="txtReplacementText" Width="150" Height="16" FontSize="12" FontWeight="Normal" Text="EQ" HorizontalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="btnReplaced" Width="100" Height="20" HorizontalAlignment="Center" Content="Override" Grid.Row="3" VerticalAlignment="Center" Click="btnReplaced_Click"/>
    </Grid>
</Window>
